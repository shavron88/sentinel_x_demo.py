# SentinelX Environment Configuration
# Copy this file to .env and adjust as needed

# --- Camera / Video ---
# Path to a video file to use as Recorded_CCTV (auto-registered as a camera)
VIDEO_FILE=evidence/videos/_demo_cctv.mp4
VIDEO_FILE_NAME=Recorded_CCTV
VIDEO_FILE_ZONE=Demo Zone

# --- Demo Mode ---
SENTINELX_DEMO=1

# --- Auth ---
SENTINELX_USER=sentinelx_admin
SENTINELX_PASSWORD=SentinelX_SecurePassword2026!

# --- Flask ---
FLASK_SECRET_KEY=sentinelx-secret-key-2026
FLASK_ENV=development
FLASK_DEBUG=1
