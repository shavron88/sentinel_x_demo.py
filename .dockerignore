# Model weights: large, and mounted/provisioned separately
models/
*.pt
*.onnx
*.engine

# Caches / build artefacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/
.envrc

# Documentation and local tooling
*.md
!README.md
kilo_*.py
